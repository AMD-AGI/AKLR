{
  "schema_version": 5,
  "name": "kimi_k3_latent_moe_gate_up_interleaved_model_dim7168_latent_dim3584_n_routed896_inter_dim384_shared_inter_dim768",
  "contract_id": "kimi_k3_latent_moe@1.0",
  "description": "sglang's KimiK3MoE._forward_fused on one rank of its TP group, up to its all-reduce: front = hidden_states front_weight^T rounded to bf16, split into the shared experts' gate and up rows, the router's logits and the latent input; each token's topk experts by sigmoid(logit) + correction_bias, weighed by their sigmoid scores renormalized; each routed expert down(situ(gate(z), up(z))) of its MXFP4 weights on the latent input z, its two linears taking their inputs in MXFP8 (aiter's a8w4), situ(g, u) = 4 tanh(g / 4) sigmoid(g) * 25 tanh(u / 25); latent is the routed experts' weighed sum and shared the shared experts' down projection of situ(gate, up), both this rank's share, which the TP group sums after the call",
  "op_type": "kimi_k3",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens in this call."
    },
    "model_dim": {
      "type": "const",
      "value": 7168,
      "description": "Hidden size."
    },
    "latent_dim": {
      "type": "const",
      "value": 3584,
      "description": "The routed experts' hidden size."
    },
    "n_routed": {
      "type": "const",
      "value": 896,
      "description": "Routed experts: the router's rows."
    },
    "inter_dim": {
      "type": "const",
      "value": 384,
      "description": "Routed expert intermediate size on this rank."
    },
    "shared_inter_dim": {
      "type": "const",
      "value": 768,
      "description": "Shared experts' intermediate size on this rank."
    },
    "shared_gate_up_rows": {
