      "value": 56,
      "description": "MXFP8 block rows of wqkv."
    },
    "q_blocks": {
      "type": "const",
      "value": 256,
      "description": "MXFP8 block rows of wq_b."
    },
    "q_rank_blocks": {
      "type": "const",
      "value": 40,
      "description": "MXFP8 blocks of a q latent row."
    }
  },
