      "description": "Rows of the RoPE table."
    },
    "n_heads": {
      "type": "const",
      "value": 16,
      "description": "Query heads on this rank."
    },
    "qkv_dim": {
      "type": "const",
      "value": 1792,
      "description": "A qkv latent row: q's latent, then the KV latent."
    },
