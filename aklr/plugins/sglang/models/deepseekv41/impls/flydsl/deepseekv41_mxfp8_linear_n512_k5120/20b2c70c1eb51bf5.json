      "type": "var",
      "description": "Rows of x."
    },
    "n": {
      "type": "const",
      "value": 512,
      "description": "Output columns."
    },
    "k": {
      "type": "const",
      "value": 5120,
      "description": "Reduction length."
    },
    "scale_rows": {
      "type": "const",
      "value": 16,
      "description": "Weight-scale rows."
    },
    "scale_columns": {
      "type": "const",
      "value": 160,
