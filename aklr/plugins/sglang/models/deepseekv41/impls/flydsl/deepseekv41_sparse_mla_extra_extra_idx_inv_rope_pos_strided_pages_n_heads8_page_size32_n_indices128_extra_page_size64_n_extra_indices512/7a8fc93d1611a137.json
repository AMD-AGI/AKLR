{
  "schema_version": 5,
  "name": "deepseekv41_sparse_mla_extra_extra_idx_inv_rope_pos_strided_pages_n_heads8_page_size32_n_indices128_extra_page_size64_n_extra_indices512",
  "contract_id": "deepseekv41_sparse_mla@1.0",
  "description": "sglang's sparse MLA of a DeepSeek-V4.1 layer on gfx950 (aiter_sparse_decode_fwd): each head of each token attends the slots its indices name (-1: none) in the layer's KV pool and in the optional extra one, with scores q . row * sm_scale; sinks join the normalisation only; the output is the softmax-weighted sum of the rows, 0 for a token that reads no row. With rope_freqs, the last 64 values of every head are then rotated back in pairs (a, b) by the pair's (c, s) at the token's position: (a c + b s, b c - a s).",
  "op_type": "deepseekv41",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens in this call, one query each."
    },
    "n_heads": {
      "type": "const",
      "value": 8,
      "description": "Query heads on this rank."
    },
    "n_pages": {
      "type": "var",
      "description": "Pages of the KV pool."
    },
    "page_size": {
      "type": "const",
      "value": 32,
      "description": "Slots per page of the KV pool."
    },
    "n_indices": {
      "type": "const",
      "value": 128,
      "description": "Indices per token into the KV pool."
    },
    "n_extra_pages": {
      "type": "var",
      "description": "Pages of the extra KV pool."
    },
    "extra_page_size": {
      "type": "const",
      "value": 64,
      "description": "Slots per page of the extra KV pool."
    },
    "n_extra_indices": {
      "type": "const",
      "value": 512,
      "description": "Indices per token into the extra KV pool."
    },
    "n_positions": {
      "type": "var",
      "description": "Rows of the RoPE table."
    }
  },
  "attrs": {
    "has_extra_kv_cache": true,
    "has_extra_indices": true,
    "has_rope_freqs": true,
    "has_positions": true
  },
  "inputs": {
    "q": {
      "shape": [
        "n_tokens",
        1,
        "n_heads",
        512
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Each token's query per head, the RoPE part last."
    },
    "kv_cache": {
      "shape": [
        "n_pages",
        "page_size",
        1,
        584
      ],
      "dtype": "uint8",
      "distribution": {
        "kind": "deepseekv4_fp8_kv_cache"
      },
      "description": "The layer's KV pool: DeepSeek-V4's packed fp8 slots."
    },
    "indices": {
      "shape": [
        "n_tokens",
        1,
        "n_indices"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": -1,
        "hi": "n_pages * page_size - 1",
        "distinct": false
      },
      "description": "Slots of the KV pool each token reads; negative: skipped."
    },
    "sinks": {
      "shape": [
        "n_heads"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "finite"
      },
      "description": "Per-head logit added to the normalisation only."
    },
    "sm_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every score."
    },
    "extra_kv_cache": {
      "shape": [
        "n_extra_pages",
        "extra_page_size",
        1,
        584
      ],
      "dtype": "uint8",
      "distribution": {
        "kind": "deepseekv4_fp8_kv_cache"
      },
      "description": "The extra KV pool, the same packed slots."
    },
    "extra_indices": {
      "shape": [
        "n_tokens",
        1,
        "n_extra_indices"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": -1,
        "hi": "n_extra_pages * extra_page_size - 1",
        "distinct": false
      },
      "description": "Slots of the extra KV pool each token reads; negative: skipped."
    },
    "rope_freqs": {
      "shape": [
        "n_positions",
        64
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "finite"
      },
      "description": "The RoPE table: a (c, s) per pair of each position."
    },
    "positions": {
      "shape": [
        "n_tokens"
      ],
      "dtype": "int64",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "n_positions - 1",
        "distinct": false
      },
      "description": "Each token's row of the RoPE table."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "n_tokens",
        1,
        "n_heads",
        512
      ],
      "dtype": "bfloat16",
      "description": "Each head's attended values, the RoPE part rotated back with rope_freqs."
    }
  },
