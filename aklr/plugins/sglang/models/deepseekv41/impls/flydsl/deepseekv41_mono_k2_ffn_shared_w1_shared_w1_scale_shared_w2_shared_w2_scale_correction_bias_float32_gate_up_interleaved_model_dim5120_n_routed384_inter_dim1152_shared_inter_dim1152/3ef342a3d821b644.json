      "value": 1152,
      "description": "Expert intermediate size on this rank."
    },
    "shared_inter_dim": {
      "type": "const",
      "value": 1152,
      "description": "The shared MLP's intermediate size on this rank."
    },
    "n_experts": {
      "type": "const",
      "value": 384,
      "description": "Expert slots: the routed experts, then the shared one unless it is an MLP."
    },
    "gate_up_rows": {
      "type": "const",
      "value": 2304,
      "description": "w1 rows: gate and up concatenated."
    },
    "model_blocks": {
      "type": "const",
      "value": 160,
      "description": "w1 scale columns."
    },
    "inter_blocks": {
      "type": "const",
      "value": 36,
