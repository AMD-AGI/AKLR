    },
    "shared_gate_up_blocks": {
      "type": "const",
      "value": 72,
      "description": "shared_w1 scale rows."
    },
    "shared_inter_blocks": {
      "type": "const",
      "value": 36,
      "description": "shared_w2 scale columns."
    }
  },
  "attrs": {
