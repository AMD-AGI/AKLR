  "schema_version": 5,
  "name": "deepseekv41_sparse_mla_kv_cache_float8_e4m3fn_padded_pages_n_heads64_page_size256_n_indices192",
  "contract_id": "deepseekv41_sparse_mla@1.0",
  "description": "sglang's sparse MLA of a DeepSeek-V4.1 layer on gfx950 (aiter_sparse_decode_fwd): each head of each token attends the slots its indices name (-1: none) in the layer's KV pool and in the optional extra one, with scores q . row * sm_scale; sinks join the normalisation only; the output is the softmax-weighted sum of the rows, 0 for a token that reads no row. With rope_freqs, the last 64 values of every head are then rotated back in pairs (a, b) by the pair's (c, s) at the token's position: (a c + b s, b c - a s).",
  "op_type": "deepseekv41",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens in this call, one query each."
    },
    "n_heads": {
      "type": "const",
      "value": 64,
      "description": "Query heads on this rank."
    },
    "n_pages": {
      "type": "var",
      "description": "Pages of the KV pool."
    },
    "page_size": {
      "type": "const",
      "value": 256,
      "description": "Slots per page of the KV pool."
    },
    "n_indices": {
      "type": "const",
      "value": 192,
      "description": "Indices per token into the KV pool."
    }
  },
  "attrs": {
    "has_extra_kv_cache": false,
    "has_extra_indices": false,
    "has_rope_freqs": false,
    "has_positions": false
  },
  "inputs": {
    "q": {
      "shape": [
        "n_tokens",
        1,
        "n_heads",
        512
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Each token's query per head, the RoPE part last."
    },
    "kv_cache": {
      "shape": [
        "n_pages",
        "page_size",
        1,
        584
      ],
      "dtype": "float8_e4m3fn",
      "distribution": {
        "kind": "deepseekv4_fp8_kv_cache"
      },
      "description": "The layer's KV pool: DeepSeek-V4's packed fp8 slots."
    },
    "indices": {
      "shape": [
        "n_tokens",
        1,
        "n_indices"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": -1,
        "hi": "n_pages * page_size - 1",
        "distinct": false
      },
      "description": "Slots of the KV pool each token reads; negative: skipped."
    },
    "sinks": {
      "shape": [
        "n_heads"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "finite"
      },
      "description": "Per-head logit added to the normalisation only."
    },
    "sm_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every score."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "n_tokens",
        1,
        "n_heads",
        512
      ],
      "dtype": "bfloat16",
      "description": "Each head's attended values, the RoPE part rotated back with rope_freqs."
    }
  },
