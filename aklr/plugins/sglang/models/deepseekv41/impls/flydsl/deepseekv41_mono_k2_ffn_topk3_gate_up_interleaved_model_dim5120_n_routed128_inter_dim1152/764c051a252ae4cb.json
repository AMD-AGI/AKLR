{
  "schema_version": 5,
  "name": "deepseekv41_mono_k2_ffn_topk3_gate_up_interleaved_model_dim5120_n_routed128_inter_dim1152",
  "contract_id": "deepseekv41_mono_k2_ffn@1.0",
  "description": "The MoE of a DeepSeek-V4.1 layer on one rank, as sglang's DeepseekV2MoE.forward_normal runs it where no monokernel takes the step, and the monokernel's K2 after the FFN seam but for the shared expert, which K2 reads from the checkpoint's FP8 weights: on hidden_states (the rows of every rank under DP attention), the router's logits in fp32; each token's topk experts by sqrt(softplus(logit)) plus correction_bias, weighed by the unbiased scores over their sum times routed_scaling_factor, and the shared expert, the last slot, at weight 1; each expert down(silu(min(gate(x), limit)) * clamp(up(x), -limit, limit)) of its MXFP4 weights, both linears' inputs in MXFP8 (e4m3 at an e8m0 scale per 32), as aiter's a8w4 experts take them; output is their sum on this rank, before sglang sums the ranks'. With shared_w1 (a vLLM TP rank's MoE) no slot is the shared expert: it is an MXFP8 MLP beside the routed ones, down(silu(min(gate(x), limit)) * clamp(up(x), -limit, limit)) of fp8 e4m3 weights at an e8m0 scale per 32 x 32 block, both linears' inputs in MXFP8, added at weight 1.",
  "op_type": "deepseekv41",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Rows in this call."
    },
    "model_dim": {
      "type": "const",
      "value": 5120,
      "description": "Hidden size."
    },
    "n_routed": {
      "type": "const",
      "value": 128,
      "description": "Routed experts: the router's rows."
    },
    "inter_dim": {
      "type": "const",
      "value": 1152,
      "description": "Expert intermediate size on this rank."
    },
    "n_experts": {
      "type": "const",
      "value": 129,
      "description": "Expert slots: the routed experts, then the shared one unless it is an MLP."
    },
    "gate_up_rows": {
      "type": "const",
      "value": 2304,
      "description": "w1 rows: gate and up concatenated."
    },
    "model_blocks": {
      "type": "const",
      "value": 160,
      "description": "w1 scale columns."
    },
    "inter_blocks": {
      "type": "const",
      "value": 36,
      "description": "w2 scale columns."
    },
    "shared_gate_up_rows": {
      "type": "const",
      "value": 64,
      "description": "shared_w1 rows: gate, then up."
    },
    "shared_gate_up_blocks": {
      "type": "const",
      "value": 2,
      "description": "shared_w1 scale rows."
    },
    "shared_inter_blocks": {
      "type": "const",
      "value": 1,
      "description": "shared_w2 scale columns."
    }
  },
  "attrs": {
    "topk": 3,
    "has_shared_w1": false,
    "has_shared_w1_scale": false,
    "has_shared_w2": false,
    "has_shared_w2_scale": false
  },
  "inputs": {
    "hidden_states": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The MoE's input: the FFN seam's normed rows."
    },
    "router_weight": {
      "shape": [
        "n_routed",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "lecun_normal",
        "fan_in": 5120
      },
      "description": "Router projection."
    },
    "correction_bias": {
      "shape": [
        "n_routed"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "lecun_normal",
        "fan_in": 5120
      },
      "description": "Added to the scores to pick experts; never weighs them."
    },
    "w1": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Gate-up projection per expert: gate rows, then up rows."
    },
    "w1_scale": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 1 x 32 block of w1."
    },
    "w2": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Down projection per expert."
    },
    "w2_scale": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -10,
        "log2_hi": -4
      },
      "description": "Per 1 x 32 block of w2."
    },
    "routed_scaling_factor": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies the routed weights only: DeepSeek-V4.1's."
    },
    "swiglu_limit": {
      "shape": null,
      "dtype": "float32",
      "description": "The gate is at most this, the up projection within +/- this."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "description": "The experts' output on this rank, before sglang sums the ranks'."
    }
  },
