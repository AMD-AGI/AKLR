      "shape": [
        "m",
        "k"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Activations: bf16, or the fp8 values x_scale scales."
    },
    "weight": {
      "shape": [
        "n",
        "k"
      ],
      "dtype": "float8_e4m3fn",
      "distribution": {
        "kind": "finite"
      },
      "description": "Weights."
    },
    "weight_scale": {
      "shape": [
        "scale_rows",
        "scale_columns"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 32 x 32 block of weight."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "m",
        "n"
      ],
      "dtype": "bfloat16",
      "description": "x @ weight.T, dequantized."
