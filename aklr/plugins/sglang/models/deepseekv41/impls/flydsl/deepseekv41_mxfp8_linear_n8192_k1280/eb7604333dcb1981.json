{
  "schema_version": 5,
  "name": "deepseekv41_mxfp8_linear_n8192_k1280",
  "contract_id": "deepseekv41_mxfp8_linear@1.0",
  "description": "sglang's MXFP8 linear of a DeepSeek-V4.1 layer on gfx950 (aiter_mxfp8_blockscaled_linear), before any bias: x @ weight.T, weight fp8 e4m3 at an e8m0 scale per 32 x 32 block. A bf16 x is first rounded to fp8 e4m3 at an e8m0 scale per 32 values of a row, the scale 2**ceil(log2(amax / 448)) of the block's largest magnitude, never below 1e-30; an fp8 x comes with those scales.",
  "op_type": "deepseekv41",
  "axes": {
    "m": {
      "type": "var",
      "description": "Rows of x."
    },
    "n": {
      "type": "const",
      "value": 8192,
      "description": "Output columns."
    },
    "k": {
      "type": "const",
      "value": 1280,
      "description": "Reduction length."
    },
    "scale_rows": {
      "type": "const",
      "value": 256,
      "description": "Weight-scale rows."
    },
    "scale_columns": {
      "type": "const",
      "value": 40,
      "description": "Scale columns."
    }
  },
  "attrs": {
    "has_x_scale": false
  },
  "inputs": {
    "x": {
      "shape": [
        "m",
        "k"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Activations: bf16, or the fp8 values x_scale scales."
    },
    "weight": {
      "shape": [
        "n",
        "k"
      ],
      "dtype": "float8_e4m3fn",
      "distribution": {
        "kind": "finite"
      },
      "description": "Weights."
    },
    "weight_scale": {
      "shape": [
        "scale_rows",
        "scale_columns"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -10,
        "log2_hi": -4
      },
      "description": "Per 32 x 32 block of weight."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "m",
        "n"
      ],
      "dtype": "bfloat16",
      "description": "x @ weight.T, dequantized."
    }
  },
