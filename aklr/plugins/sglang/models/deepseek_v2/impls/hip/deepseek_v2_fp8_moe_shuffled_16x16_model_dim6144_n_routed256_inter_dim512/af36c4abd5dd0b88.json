{
  "schema_version": 5,
  "name": "deepseek_v2_fp8_moe_shuffled_16x16_model_dim6144_n_routed256_inter_dim512",
  "contract_id": "deepseek_v2_fp8_moe@1.0",
  "description": "sglang's DeepseekV2MoE on one rank, with fp8 experts and the shared expert in their last slot: on hidden_states, each token's topk experts by sigmoid score plus correction_bias, the scores those of the router's logits in hidden_states' dtype (as sglang's MoEGate returns them on ROCm), weighed by the renormalized unbiased scores times routed_scaling_factor, and the shared expert at weight 1, each expert down(silu(gate(x)) * up(x)) of its fp8 weights at a scale per 128 x 128 block, each of its two linears taking its input as the checkpoint's FP8 scheme quantizes it: in bf16, then each 1 x 128 group in fp8 at a scale of its amax / 448; out is their output on this rank, which sglang sums over the ranks.",
  "op_type": "deepseek_v2",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens in this call."
    },
    "model_dim": {
      "type": "const",
      "value": 6144,
      "description": "Hidden size."
    },
    "n_routed": {
      "type": "const",
      "value": 256,
      "description": "Routed experts: the router's rows."
    },
    "inter_dim": {
      "type": "const",
      "value": 512,
      "description": "Expert intermediate size on this rank."
    },
    "n_experts": {
      "type": "const",
      "value": 257,
      "description": "Expert slots: the routed experts, then the shared one."
    },
    "gate_up_rows": {
      "type": "const",
      "value": 1024,
      "description": "w1 rows: gate and up concatenated."
    },
    "model_blocks": {
      "type": "const",
      "value": 48,
      "description": "128-blocks of the hidden size."
    },
    "gate_up_blocks": {
      "type": "const",
      "value": 8,
      "description": "128-blocks of w1's rows."
    },
    "inter_blocks": {
      "type": "const",
      "value": 4,
      "description": "128-blocks of the intermediate size."
    }
  },
  "attrs": {
    "topk": 8,
    "num_expert_group": 1,
    "topk_group": 1,
    "renormalize": true,
    "scoring_func": "sigmoid"
  },
  "inputs": {
    "hidden_states": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The MoE's input: post_attention_layernorm's output."
    },
    "router_weight": {
      "shape": [
        "n_routed",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "lecun_normal",
        "fan_in": 6144
      },
      "description": "Router projection."
    },
    "correction_bias": {
      "shape": [
        "n_routed"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": "2.99",
        "log2_hi": "3.01"
      },
      "description": "Added to the scores to pick experts; never weighs them."
    },
    "w1": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_dim"
      ],
      "dtype": "float8_e4m3fn",
      "distribution": {
        "kind": "lecun_normal",
        "fan_in": 6144
      },
      "description": "Gate-up projection per expert: gate rows, then up rows."
    },
    "w1_scale": {
      "shape": [
        "n_experts",
        "gate_up_blocks",
        "model_blocks"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -3,
        "log2_hi": 0
      },
      "description": "w1's dequant scale per 128 x 128 block."
    },
    "w2": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_dim"
      ],
      "dtype": "float8_e4m3fn",
      "distribution": {
        "kind": "lecun_normal",
        "fan_in": 512
      },
      "description": "Down projection per expert."
    },
    "w2_scale": {
      "shape": [
        "n_experts",
        "model_blocks",
        "inter_blocks"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -3,
        "log2_hi": 0
      },
      "description": "w2's dequant scale per 128 x 128 block."
    },
    "routed_scaling_factor": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies the routed weights only: GLM-5's."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "description": "The experts' output on this rank, before sglang's all-reduce sums the ranks'."
    }
  },
  "workloads": [
