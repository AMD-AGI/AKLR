{
  "schema_version": 5,
  "name": "deepseek_v2_mxfp4_moe_shuffled_16x16_model_dim6144_n_routed256_inter_dim256",
  "contract_id": "deepseek_v2_mxfp4_moe@1.0",
  "description": "sglang's DeepseekV2MoE on one rank, with MXFP4 experts and the shared expert in their last slot: on hidden_states, each token's topk experts by sigmoid score plus correction_bias, the scores those of the router's logits in hidden_states' dtype (as sglang's MoEGate returns them on ROCm), weighed by the renormalized unbiased scores times routed_scaling_factor, and the shared expert at weight 1, each expert down(silu(gate(x)) * up(x)) of its MXFP4 weights (fused_moe's: fp4 values at an e8m0 scale per 32); out is their output on this rank, which sglang sums over the ranks.",
  "op_type": "deepseek_v2",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens in this call."
    },
    "model_dim": {
      "type": "const",
      "value": 6144,
      "description": "Hidden size."
    },
    "n_routed": {
      "type": "const",
      "value": 256,
      "description": "Routed experts: the router's rows."
    },
    "inter_dim": {
      "type": "const",
      "value": 256,
      "description": "Expert intermediate size on this rank."
    },
    "n_experts": {
      "type": "const",
      "value": 257,
      "description": "Expert slots: the routed experts, then the shared one."
    },
    "gate_up_rows": {
      "type": "const",
      "value": 512,
      "description": "w1 rows: gate and up concatenated."
    },
    "model_blocks": {
      "type": "const",
      "value": 192,
      "description": "w1 scale columns."
    },
    "inter_blocks": {
      "type": "const",
      "value": 8,
      "description": "w2 scale columns."
    }
  },
  "attrs": {
    "topk": 8,
    "num_expert_group": 1,
    "topk_group": 1,
    "renormalize": true,
    "scoring_func": "sigmoid"
  },
  "inputs": {
    "hidden_states": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The MoE's input: post_attention_layernorm's output."
    },
    "router_weight": {
      "shape": [
        "n_routed",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "lecun_normal",
        "fan_in": 6144
      },
      "description": "Router projection."
    },
    "correction_bias": {
      "shape": [
        "n_routed"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": "2.99",
        "log2_hi": "3.01"
      },
      "description": "Added to the scores to pick experts; never weighs them."
    },
    "w1": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Gate-up projection per expert: gate rows, then up rows."
    },
    "w1_scale": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 1 x 32 block of w1."
    },
    "w2": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Down projection per expert."
    },
    "w2_scale": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -9,
        "log2_hi": -3
      },
      "description": "Per 1 x 32 block of w2."
    },
    "routed_scaling_factor": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies the routed weights only: GLM-5's."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "description": "The experts' output on this rank, before sglang's all-reduce sums the ranks'."
    }
  },
  "workloads": [
    {
      "axes": {
        "n_tokens": 32
      },
      "scalars": {
        "routed_scaling_factor": 2.5
      }
    }
  ],
  "layout_variants": {
    "by_name": {
      "shuffled_16x16": {
        "layouts": {
          "w1": {
            "kind": "preshuffle",
            "tile": [16, 16]
          },
          "w2": {
            "kind": "preshuffle",
            "tile": [16, 16]
          },
          "w1_scale": {
            "kind": "e8m0_scales",
            "block_size": 32,
            "pad_to": [256, 8],
            "shuffled": true
          },
          "w2_scale": {
            "kind": "e8m0_scales",
            "block_size": 32,
            "pad_to": [256, 8],
            "shuffled": true
          }
        },
        "detect_facts": [
          {
            "location": "tensor_attr",
            "name": "w1.is_shuffled",
            "expected_value": true
          },
          {
            "location": "tensor_attr",
            "name": "w2.is_shuffled",
            "expected_value": true
          },
          {
            "location": "tensor_attr",
            "name": "w1_scale.ndim",
            "expected_value": 3
          }
        ]
      }
    }
  },
  "compare": {
    "determinism": "bounded"
  },
  "kernel": {
    "language": "triton",
    "targets": [
      {
        "arch": "gfx950",
        "hardware": "MI355X"
      }
    ],
    "entry_point": "kernel.py::run",
    "sources": []
  }
}
