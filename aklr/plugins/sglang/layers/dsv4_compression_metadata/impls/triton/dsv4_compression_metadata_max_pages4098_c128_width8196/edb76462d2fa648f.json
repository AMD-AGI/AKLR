    "entry_point": "kernel.py::run",
    "sources": [
      {
        "path": "kernel.py",
        "content": "\"\"\"DeepSeek-V4 compressed-cache metadata: program (b, c) writes columns [c * BLOCK, (c + 1) * BLOCK) of row b's\nratio-128 page indices, and the c == 0 program also the row's per-ratio slot, position and lengths, so a long page\ntable spreads over the grid instead of one program per row.\"\"\"\n\nimport triton\nimport triton.language as tl\n\n\n@triton.jit(do_not_specialize=[\"n_write\"])\ndef _metadata_kernel(\n    seq_lens_ptr, positions_ptr, raw_out_loc_ptr, page_table_ptr,\n    c4_out_loc_ptr, c4_positions_ptr, c4_raw_ptr, c4_clamp_ptr,\n    c128_out_loc_ptr, c128_positions_ptr, c128_raw_ptr, c128_clamp_ptr, c128_pages_ptr,\n    n_write, MAX_PAGES: tl.constexpr, PAGE: tl.constexpr, BLOCK: tl.constexpr,\n):\n    b = tl.program_id(0)\n    c = tl.program_id(1)\n    seq_len = tl.load(seq_lens_ptr + b)\n    raw128 = seq_len // 128\n    if c == 0:\n        position = tl.load(positions_ptr + b)\n        writes = b < n_write\n        loc = tl.load(raw_out_loc_ptr + b, mask=writes, other=0)\n        tl.store(c4_out_loc_ptr + b, tl.where((seq_len % 4) == 0, loc // 4, 0), mask=writes)\n        tl.store(c4_positions_ptr + b, position & (~3))\n        raw4 = seq_len // 4\n        tl.store(c4_raw_ptr + b, raw4)\n        tl.store(c4_clamp_ptr + b, tl.maximum(raw4, 1))\n        tl.store(c128_out_loc_ptr + b, tl.where((seq_len % 128) == 0, loc // 128, 0), mask=writes)\n        tl.store(c128_positions_ptr + b, position & (~127))\n        tl.store(c128_raw_ptr + b, raw128)\n        tl.store(c128_clamp_ptr + b, tl.maximum(raw128, 1))\n    width: tl.constexpr = MAX_PAGES * PAGE\n    cols = c * BLOCK + tl.arange(0, BLOCK)\n    inside = cols < width\n    valid = cols < raw128\n    pages = tl.load(page_table_ptr + b * MAX_PAGES + cols // PAGE, mask=valid, other=0)\n    slots = tl.where(valid, pages * PAGE + cols % PAGE, -1)\n    tl.store(c128_pages_ptr + b * width + cols, slots, mask=inside)\n\n\ndef run(*, seq_lens, positions, raw_out_loc, page_table, c4_out_loc, c4_positions, c4_seq_lens_raw,\n        c4_seq_lens_clamp1, c128_out_loc, c128_positions, c128_seq_lens_raw, c128_seq_lens_clamp1,\n        c128_page_indices):\n    rows, max_pages = page_table.shape\n    width = c128_page_indices.shape[1]\n    block = min(1024, triton.next_power_of_2(width))\n    _metadata_kernel[(rows, triton.cdiv(width, block))](\n        seq_lens, positions, raw_out_loc, page_table,\n        c4_out_loc, c4_positions, c4_seq_lens_raw, c4_seq_lens_clamp1,\n        c128_out_loc, c128_positions, c128_seq_lens_raw, c128_seq_lens_clamp1, c128_page_indices,\n        raw_out_loc.shape[0], MAX_PAGES=max_pages, PAGE=width // max_pages, BLOCK=block, num_warps=4,\n    )\n"
      }
