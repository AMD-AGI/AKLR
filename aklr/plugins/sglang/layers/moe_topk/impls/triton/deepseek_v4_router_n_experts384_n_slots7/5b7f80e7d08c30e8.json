{
  "schema_version": 5,
  "name": "deepseek_v4_router_n_experts384_n_slots7",
  "contract_id": "deepseek_v4_router@1.0",
  "description": "sglang's select_experts on ROCm for a sqrtsoftplus router whose shared experts are fused into the top-k (DeepSeek-V4): each token's n_slots - n_shared experts by sqrt(softplus(router_logits)) + correction_bias, weighed with the unbiased scores, divided by their sum when renormalize, times routed_scaling_factor; then n_shared columns of shared experts n_experts + s at weight shared_scale. Rows at or past num_token_non_padded, when given, keep the shared ids and take routed ids 0 and weights 0.",
  "op_type": "moe_topk",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens routed in this call."
    },
    "n_experts": {
      "type": "const",
      "value": 384,
      "description": "Routed experts scored per token."
    },
    "n_slots": {
      "type": "const",
      "value": 7,
      "description": "Experts per token: the routed ones, then the n_shared shared ones."
    }
  },
  "attrs": {
    "n_shared": 1,
    "renormalize": true,
    "has_num_token_non_padded": false
  },
  "inputs": {
    "router_logits": {
      "shape": [
        "n_tokens",
        "n_experts"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Router logits per token."
    },
    "correction_bias": {
      "shape": [
        "n_experts"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Per-expert bias added to the scores for selection only."
    },
    "routed_scaling_factor": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every routed weight."
    },
    "shared_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "The weight of every shared expert column."
    }
  },
  "outputs": {
    "topk_weights": {
      "shape": [
        "n_tokens",
        "n_slots"
      ],
      "dtype": "float32",
      "description": "Per token: the routed experts' unbiased scores, renormalized and scaled, then shared_scale per shared expert; 0 on padded rows."
    },
    "topk_ids": {
      "shape": [
        "n_tokens",
        "n_slots"
      ],
      "dtype": "int32",
      "description": "Per token: the routed experts by descending biased score (0 on padded rows), then shared experts n_experts .. n_experts + n_shared - 1."
    }
  },
