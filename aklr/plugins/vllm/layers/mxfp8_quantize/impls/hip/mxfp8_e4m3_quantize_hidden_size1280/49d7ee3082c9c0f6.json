{
  "schema_version": 5,
  "name": "mxfp8_e4m3_quantize_hidden_size1280",
  "contract_id": "mxfp8_e4m3_quantize@1.0",
  "description": "vLLM's MXFP8 quantization of BF16 activations: per row and group of 32 values, the scale byte is ceil(log2(max(amax, FLT_MIN) / 448)) + 127 clamped to [0, 254], and the values are x * 2**(127 - byte) rounded to E4M3FN. Scales are row-major [row, group].",
  "op_type": "mxfp8_quantize",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Rows quantized independently."
    },
    "hidden_size": {
      "type": "const",
      "value": 1280,
      "description": "Elements per row, divisible by 32."
    },
    "n_groups": {
      "type": "const",
      "value": 40,
      "description": "Groups of 32 elements per row."
    }
  },
  "attrs": {},
  "inputs": {
    "x": {
      "shape": [
        "n_tokens",
        "hidden_size"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Finite BF16 activations, rows contiguous."
    }
  },
  "outputs": {
    "quantized": {
      "shape": [
        "n_tokens",
        "hidden_size"
      ],
      "dtype": "float8_e4m3fn",
      "description": "E4M3FN quantized activations."
    },
    "scales": {
      "shape": [
        "n_tokens",
        "n_groups"
      ],
      "dtype": "uint8",
      "description": "E8M0 exponent bytes at [row, group]; the dequantization scale is 2**(byte - 127)."
    }
  },
