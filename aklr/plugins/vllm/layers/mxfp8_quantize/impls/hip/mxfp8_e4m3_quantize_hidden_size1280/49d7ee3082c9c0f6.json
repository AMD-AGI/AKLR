    "entry_point": "kernel.hip::run",
    "sources": [
      {
        "path": "kernel.hip",
        "content": "// vLLM's group-32 BF16 to MXFP8 quantization (scale byte clamped to [0, 254]), two lanes per group.\n// SPDX-License-Identifier: MIT\n// Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.\n#include <ATen/hip/HIPContext.h>\n#include <hip/hip_runtime.h>\n#include <torch/library.h>\n#include <cstdint>\n\nnamespace {\nusing u32x4 = uint32_t __attribute__((ext_vector_type(4)));\nusing u32x8 = uint32_t __attribute__((ext_vector_type(8)));\nusing u16x2 = unsigned short __attribute__((ext_vector_type(2)));\n\ntemplate<int Threads>\n__global__ __launch_bounds__(Threads)\nvoid quantize(const uint16_t* __restrict__ x, uint8_t* __restrict__ y,\n              uint8_t* __restrict__ scales, int64_t elements) {\n    const int64_t slot = int64_t(blockIdx.x) * Threads + threadIdx.x;\n    if (slot >= elements / 16) return;\n    const u32x8 data = *reinterpret_cast<const u32x8*>(x + slot * 16);\n    u16x2 maximum = __builtin_bit_cast(u16x2, data[0] & 0x7FFF7FFFu);\n#pragma unroll\n    for (int i = 1; i < 8; ++i)\n        maximum = __builtin_elementwise_max(maximum, __builtin_bit_cast(u16x2, data[i] & 0x7FFF7FFFu));\n    uint32_t max_bits = maximum[0] > maximum[1] ? maximum[0] : maximum[1];\n    const uint32_t other = __builtin_amdgcn_mov_dpp(max_bits, 0xB1, 0xF, 0xF, true);\n    max_bits = max_bits > other ? max_bits : other;\n    // float32 bits of the amax, floored at FLT_MIN\n    uint32_t amax = max_bits << 16;\n    amax = amax < 0x00800000u ? 0x00800000u : amax;\n    // ceil(log2(amax / 448)) + 127: 448 is 1.75 * 2**8, and a BF16 mantissa above 1.75 rounds up\n    int byte = int(amax >> 23) - 8 + ((amax & 0x7FFFFFu) > 0x600000u);\n    byte = byte < 0 ? 0 : (byte > 254 ? 254 : byte);\n    const float rescale = __builtin_bit_cast(float, uint32_t(254 - byte) << 23);\n    u32x4 packed;\n#pragma unroll\n    for (int i = 0; i < 4; ++i) {\n        const uint32_t lo = data[2 * i], hi = data[2 * i + 1];\n        const float a = __builtin_bit_cast(float, lo << 16) * rescale;\n        const float b = __builtin_bit_cast(float, lo & 0xffff0000u) * rescale;\n        const float c = __builtin_bit_cast(float, hi << 16) * rescale;\n        const float d = __builtin_bit_cast(float, hi & 0xffff0000u) * rescale;\n        int result = __builtin_amdgcn_cvt_pk_fp8_f32(a, b, 0, false);\n        result = __builtin_amdgcn_cvt_pk_fp8_f32(c, d, result, true);\n        packed[i] = result;\n    }\n    *reinterpret_cast<u32x4*>(y + slot * 16) = packed;\n    if ((threadIdx.x & 1) == 0) scales[slot / 2] = uint8_t(byte);\n}\n\nvoid run(const at::Tensor& x, at::Tensor& quantized, at::Tensor& scales) {\n    const int64_t elements = x.numel();\n    auto xp = static_cast<const uint16_t*>(x.data_ptr());\n    auto yp = static_cast<uint8_t*>(quantized.data_ptr());\n    auto sp = static_cast<uint8_t*>(scales.data_ptr());\n    const auto stream = at::hip::getCurrentHIPStream();\n    if (elements >= (int64_t{32} << 20))\n        quantize<128><<<(elements / 16 + 127) / 128, 128, 0, stream>>>(xp, yp, sp, elements);\n    else\n        quantize<256><<<(elements / 16 + 256 - 1) / 256, 256, 0, stream>>>(xp, yp, sp, elements);\n}\n} // namespace\n\n#define TORCH_LIBRARY_EXPAND(ns, m) TORCH_LIBRARY(ns, m)\nTORCH_LIBRARY_EXPAND(TORCH_EXTENSION_NAME, m) {\n    m.def(\"run(Tensor x, Tensor(a!) quantized, Tensor(b!) scales) -> ()\", &run);\n}\n"
      }
    ]
