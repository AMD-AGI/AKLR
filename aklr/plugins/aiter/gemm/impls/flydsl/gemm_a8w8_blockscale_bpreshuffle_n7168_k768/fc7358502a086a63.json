        "kind": "finite"
      },
      "description": "Activations."
    },
    "WQ": {
      "shape": [
        "n",
        "k"
      ],
      "dtype": "float8_e4m3fn",
      "distribution": {
        "kind": "finite"
      },
      "description": "Weights; (n, k) when trans_b."
    },
    "x_scale": {
      "shape": [
        "m",
