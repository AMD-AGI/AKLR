      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -3,
        "log2_hi": 0
      },
      "description": "Per 1 x 128 block of XQ."
    },
    "w_scale": {
      "shape": [
        "scale_rows",
        "scale_columns"
      ],
      "dtype": "float32",
