  "axes": {
    "m": {
      "type": "var",
      "description": "Tokens."
    },
    "n": {
      "type": "const",
      "value": 7168,
      "description": "Output columns."
    },
    "k": {
      "type": "const",
      "value": 768,
      "description": "Reduction length."
    },
    "scale_rows": {
      "type": "const",
      "value": 56,
      "description": "Weight-scale rows."
    },
    "scale_columns": {
      "type": "const",
      "value": 6,
      "description": "Scale columns."
    }
  },
  "attrs": {},
  "inputs": {
    "XQ": {
      "shape": [
        "m",
        "k"
      ],
      "dtype": "float8_e4m3fn",
