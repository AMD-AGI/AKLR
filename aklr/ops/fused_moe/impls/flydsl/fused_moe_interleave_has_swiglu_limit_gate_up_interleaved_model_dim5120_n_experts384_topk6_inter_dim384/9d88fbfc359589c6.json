  "schema_version": 5,
  "name": "fused_moe_interleave_has_swiglu_limit_gate_up_interleaved_model_dim5120_n_experts384_topk6_inter_dim384",
  "contract_id": "fused_moe@1.0",
  "description": "Route each token to its top-k experts, run both projections, combine.",
  "op_type": "fused_moe",
  "axes": {
