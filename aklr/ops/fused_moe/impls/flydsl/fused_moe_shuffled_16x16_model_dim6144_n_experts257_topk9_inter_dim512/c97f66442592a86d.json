  ],
  "layout_variants": {
    "by_name": {
      "shuffled_16x16": {
        "layouts": {
          "w1": {
            "kind": "preshuffle",
            "tile": [16, 16]
          },
          "w2": {
            "kind": "preshuffle",
            "tile": [16, 16]
          },
          "w1_scale": {
            "kind": "e8m0_scales",
            "block_size": 32,
            "pad_to": [256, 8],
            "shuffled": true
          },
          "w2_scale": {
            "kind": "e8m0_scales",
            "block_size": 32,
            "pad_to": [256, 8],
            "shuffled": true
          }
        },
        "detect_facts": [
          {
            "location": "tensor_attr",
            "name": "w1.is_shuffled",
            "expected_value": true
          },
          {
            "location": "tensor_attr",
            "name": "w2.is_shuffled",
            "expected_value": true
          },
          {
            "location": "tensor_attr",
            "name": "w1_scale.ndim",
            "expected_value": 3
          }
        ]
      }
    }
  },
  "compare": {
    "max_violation_fraction": 0.001,
