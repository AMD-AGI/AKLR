{
  "schema_version": 5,
  "name": "fused_moe_shuffled_16x16_model_dim6144_n_experts257_topk9_inter_dim512",
  "contract_id": "fused_moe@1.0",
  "description": "Route each token to its top-k experts, run both projections, combine.",
  "op_type": "fused_moe",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens routed in this call."
    },
    "model_dim": {
      "type": "const",
      "value": 6144,
      "description": "Hidden size."
    },
    "n_experts": {
      "type": "const",
      "value": 257,
      "description": "Local experts on this rank."
    },
    "topk": {
      "type": "const",
      "value": 9,
      "description": "Experts per token."
    },
    "inter_dim": {
      "type": "const",
      "value": 512,
      "description": "Expert intermediate size."
    },
    "gate_up_rows": {
      "type": "const",
      "value": 1024,
      "description": "w1 rows: gate and up concatenated."
    },
    "model_blocks": {
      "type": "const",
      "value": 192,
      "description": "w1 scale columns."
    },
    "inter_blocks": {
      "type": "const",
      "value": 16,
      "description": "w2 scale columns."
    }
  },
  "attrs": {
    "activation": "silu",
    "quant_type": "per_1x32",
    "doweight_stage1": false,
    "gate_mode": "separated",
    "has_expert_mask": false,
    "act_quant": 4
  },
  "inputs": {
    "hidden_states": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Token activations."
    },
    "w1": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Gate-up projection per expert: gate rows, then up rows."
    },
    "w2": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Down projection per expert."
    },
    "topk_weights": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "finite"
      },
      "description": "Routing weight of each chosen expert."
    },
    "topk_ids": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": 256,
        "distinct": true
      },
      "description": "Chosen experts per token, distinct within a row; global ids under expert parallelism."
    },
    "w1_scale": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 1 x 32 block of w1."
    },
    "w2_scale": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -10,
        "log2_hi": -4
      },
      "description": "Per 1 x 32 block of w2."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "description": "Routing-weighted sum of the chosen experts' outputs; under expert parallelism, this rank's share."
    }
  },
  "workloads": [
    {
      "axes": {
        "n_tokens": 1
      }
    },
    {
      "axes": {
