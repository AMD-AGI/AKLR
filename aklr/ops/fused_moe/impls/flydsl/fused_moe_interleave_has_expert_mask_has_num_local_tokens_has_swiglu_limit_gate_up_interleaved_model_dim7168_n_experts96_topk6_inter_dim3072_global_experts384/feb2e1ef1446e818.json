{
  "schema_version": 5,
  "name": "fused_moe_interleave_has_expert_mask_has_num_local_tokens_has_swiglu_limit_gate_up_interleaved_model_dim7168_n_experts96_topk6_inter_dim3072_global_experts384",
  "contract_id": "fused_moe@1.0",
  "description": "Route each token to its top-k experts, run both projections, combine.",
  "op_type": "fused_moe",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens routed in this call."
    },
    "model_dim": {
      "type": "const",
      "value": 7168,
      "description": "Hidden size."
    },
    "n_experts": {
      "type": "const",
      "value": 96,
      "description": "Local experts on this rank."
    },
    "topk": {
      "type": "const",
      "value": 6,
      "description": "Experts per token."
    },
    "inter_dim": {
      "type": "const",
      "value": 3072,
      "description": "Expert intermediate size."
    },
    "global_experts": {
      "type": "const",
      "value": 384,
      "description": "Experts of the whole expert-parallel group."
    },
    "gate_up_rows": {
      "type": "const",
      "value": 6144,
      "description": "w1 rows: gate and up concatenated."
    },
    "model_blocks": {
      "type": "const",
      "value": 224,
      "description": "w1 scale columns."
    },
    "inter_blocks": {
      "type": "const",
      "value": 96,
      "description": "w2 scale columns."
    }
  },
  "attrs": {
    "activation": "silu",
    "quant_type": "per_1x32",
    "doweight_stage1": false,
    "gate_mode": "interleave",
    "has_expert_mask": true,
    "has_num_local_tokens": true,
    "has_swiglu_limit": true,
    "act_quant": 4
  },
  "inputs": {
    "hidden_states": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Token activations."
    },
    "w1": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Gate-up projection per expert: gate rows, then up rows."
    },
    "w2": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Down projection per expert."
    },
    "topk_weights": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "finite"
      },
      "description": "Routing weight of each chosen expert."
    },
    "topk_ids": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": 383,
        "distinct": true
      },
      "description": "Chosen experts per token, distinct within a row; global ids under expert parallelism."
    },
    "w1_scale": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 1 x 32 block of w1."
    },
    "w2_scale": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 1 x 32 block of w2."
    },
    "expert_mask": {
      "shape": [
        "global_experts"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "expert_mask",
        "local_experts": 96
      },
      "description": "1 for the experts this rank holds, in the order w1 holds them."
    },
    "num_local_tokens": {
      "shape": [1],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": "n_tokens",
        "hi": "n_tokens",
        "distinct": false
      },
      "description": "Rows this rank received; later rows are unused."
    },
    "swiglu_limit": {
      "shape": null,
      "dtype": "float32",
      "description": "Clamped SwiGLU bound: gate at most this, up within +/- this."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "description": "Routing-weighted sum of the chosen experts' outputs; under expert parallelism, this rank's share."
    }
  },
  "workloads": [
    {
      "axes": {
        "n_tokens": 1024
      },
      "scalars": {
        "swiglu_limit": 10.0
      }
    }
  ],
  "layout_variants": {
    "by_name": {
      "gate_up_interleaved": {
        "layouts": {
          "w1": {
            "kind": "gate_up_interleaved_weight",
            "gate_up": true
          },
          "w2": {
            "kind": "gate_up_interleaved_weight",
            "gate_up": false
          },
          "w1_scale": {
            "kind": "gate_up_interleaved_scales",
            "gate_up": true
          },
          "w2_scale": {
            "kind": "gate_up_interleaved_scales",
            "gate_up": false
          }
        },
        "detect_facts": [
          {
            "location": "tensor_attr",
            "name": "w1.is_shuffled",
            "expected_value": true
          },
          {
            "location": "tensor_attr",
            "name": "w2.is_shuffled",
            "expected_value": true
          },
          {
            "location": "tensor_attr",
            "name": "w1_scale.ndim",
            "expected_value": 2
          }
        ]
      }
    }
  },
  "compare": {
    "max_violation_fraction": 0.001,
    "determinism": "bounded",
    "element_order": "fixed"
  },
  "kernel": {
    "language": "flydsl",
    "targets": [
      {
        "arch": "gfx950",
        "hardware": "MI355X"
      }
    ],
    "entry_point": "kernel.py::run",
    "sources": []
  }
}
