      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": 383,
        "distinct": true
      },
      "description": "Chosen experts per token, distinct within a row; global ids under expert parallelism."
    },
    "w1_scale": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -11,
        "log2_hi": -5
      },
      "description": "Per 1 x 32 block of w1."
    },
    "w2_scale": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_blocks"
      ],
      "dtype": "float8_e8m0",
      "distribution": {
        "kind": "log_uniform",
        "log2_lo": -10,
        "log2_hi": -4
      },
      "description": "Per 1 x 32 block of w2."
    },
    "swiglu_limit": {
      "shape": null,
      "dtype": "float32",
      "description": "Clamped SwiGLU bound: gate at most this, up within +/- this."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "n_tokens",
        "model_dim"
      ],
      "dtype": "bfloat16",
      "description": "Routing-weighted sum of the chosen experts' outputs; under expert parallelism, this rank's share."
    }
  },
