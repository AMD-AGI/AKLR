    },
    "w1": {
      "shape": [
        "n_experts",
        "gate_up_rows",
        "model_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
        "kind": "finite"
      },
      "description": "Gate-up projection per expert: gate rows, then up rows."
    },
    "w2": {
      "shape": [
        "n_experts",
        "model_dim",
        "inter_dim"
      ],
      "dtype": "float4_e2m1",
      "distribution": {
