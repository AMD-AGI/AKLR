{
  "schema_version": 5,
  "name": "biased_grouped_topk_renormalize_n_experts896_topk16",
  "contract_id": "biased_grouped_topk@1.0",
  "description": "Pick topk experts per token by sigmoid(router_logits) + correction_bias; weigh them with the unbiased sigmoid scores, divided by their sum when renormalize, times routed_scaling_factor. Expert groups are all kept (topk_group == num_expert_group), so grouping selects nothing.",
  "op_type": "topk",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Tokens routed in this call."
    },
    "n_experts": {
      "type": "const",
      "value": 896,
      "description": "Experts scored per token."
    },
    "topk": {
      "type": "const",
      "value": 16,
      "description": "Experts chosen per token."
    }
  },
  "attrs": {
    "num_expert_group": 1,
    "topk_group": 1,
    "renormalize": true
  },
  "inputs": {
    "router_logits": {
      "shape": [
        "n_tokens",
        "n_experts"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Router logits per token."
    },
    "correction_bias": {
      "shape": [
        "n_experts"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "Per-expert bias added to the scores for selection only."
    },
    "routed_scaling_factor": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every weight."
    }
  },
  "outputs": {
    "topk_weights": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "float32",
      "description": "Unbiased sigmoid scores of the chosen experts, renormalized and scaled."
    },
    "topk_ids": {
      "shape": [
        "n_tokens",
        "topk"
      ],
      "dtype": "int32",
      "description": "Chosen experts, by descending biased score."
    }
  },
