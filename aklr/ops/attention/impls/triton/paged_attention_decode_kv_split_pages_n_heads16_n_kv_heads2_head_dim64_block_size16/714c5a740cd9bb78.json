{
  "schema_version": 5,
  "name": "paged_attention_decode_kv_split_pages_n_heads16_n_kv_heads2_head_dim64_block_size16",
  "contract_id": "paged_attention_decode@1.0",
  "description": "Decode attention over a paged KV cache: query head h of each request attends to KV head h // (n_heads / n_kv_heads) of the first context_lens tokens its block_tables row names, block_size tokens a block; with sliding_window > 0 only to the last sliding_window of them. Logits are q . k * scale.",
  "op_type": "attention",
  "axes": {
    "batch": {
      "type": "var",
      "description": "Requests, one query token each."
    },
    "n_heads": {
      "type": "const",
      "value": 16,
      "description": "Query heads."
    },
    "n_kv_heads": {
      "type": "const",
      "value": 2,
      "description": "KV heads."
    },
    "head_dim": {
      "type": "const",
      "value": 64,
      "description": "Values per head."
    },
    "n_blocks": {
      "type": "var",
      "description": "Blocks of the KV cache."
    },
    "block_size": {
      "type": "const",
      "value": 16,
      "description": "Tokens per block."
    },
    "max_blocks": {
      "type": "var",
      "description": "Blocks per request in the block table."
    }
  },
  "attrs": {
    "kv_cache_dtype": "auto",
    "kv_cache_layout": "NHD",
    "has_alibi_slopes": false
  },
  "inputs": {
    "query": {
      "shape": [
        "batch",
        "n_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The query of each request."
    },
    "key_cache": {
      "shape": [
        "n_blocks",
        "block_size",
        "n_kv_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The keys of every cached token, block by block."
    },
    "value_cache": {
      "shape": [
        "n_blocks",
        "block_size",
        "n_kv_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The values of every cached token, block by block."
    },
    "block_tables": {
      "shape": [
        "batch",
        "max_blocks"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "n_blocks - 1",
        "distinct": false
      },
      "description": "The blocks of each request, in context order."
    },
    "context_lens": {
      "shape": [
        "batch"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 1,
        "hi": "max_blocks * block_size",
        "distinct": false
      },
      "description": "Cached tokens of each request, the query's own included."
    },
    "scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every logit."
    },
    "sliding_window": {
      "shape": null,
      "dtype": "int32",
      "description": "Trailing tokens each query reads; 0 reads the whole context."
    },
    "logits_soft_cap": {
      "shape": null,
      "dtype": "float32",
      "description": "Logit soft cap; 0 is none."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "batch",
        "n_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "description": "Softmax-weighted sum of the read values."
    }
  },
