    "out": {
      "shape": [
        "batch",
        "n_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "description": "Softmax-weighted sum of the read values."
    }
  },
  "tags": [],
  "description": "Decode attention over a paged KV cache: query head h of each request attends to KV head h // (n_heads / n_kv_heads) of the first context_lens tokens its block_tables row names, block_size tokens a block; with sliding_window > 0 only to the last sliding_window of them. Logits are q . k * scale. vLLM's storage: the key and the value caches are the two halves of each row of one (blocks, heads, tokens, 2 * head_dim) buffer, the query rows of a wider buffer.",
  "constraints": [
    "n_heads % n_kv_heads == 0",
    "n_heads // n_kv_heads <= 16",
    "head_dim in (64, 128, 256)",
    "block_size in (16, 32)",
    "n_blocks * block_size <= 2147483648",
    "query.dtype in ('bfloat16', 'float16')",
    "key_cache.dtype == value_cache.dtype == query.dtype",
    "kv_cache_storage == 'kv_split_pages'",
    "kv_cache_dtype == 'auto' and kv_cache_layout == 'NHD'",
    "alibi_slopes is None and logits_soft_cap == 0"
  ],
  "kernel": null
}
