  "inputs": {
    "query": {
      "shape": [
        "batch",
        "n_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "description": "The query of each request."
    },
    "key_cache": {
      "shape": [
        "n_blocks",
        "block_size",
        "n_kv_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
