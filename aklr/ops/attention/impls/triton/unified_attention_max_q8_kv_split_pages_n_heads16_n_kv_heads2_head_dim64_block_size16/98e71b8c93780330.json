{
  "schema_version": 5,
  "name": "unified_attention_max_q8_kv_split_pages_n_heads16_n_kv_heads2_head_dim64_block_size16",
  "contract_id": "unified_attention@1.0",
  "description": "Causal varlen attention of a batch of requests' new tokens over a paged KV cache, vLLM's multi-token decode: request i owns query rows cu_seqlens_q[i] to cu_seqlens_q[i + 1] and the first seqused_k[i] tokens its block_table row names, block_size tokens a block, its new tokens last. Query j of a request of L new tokens sits at position seqused_k - L + j and reads the tokens at or before it; with window_size[0] >= 0 only those at most window_size[0] before it (causal: window_size[1] is not read). Query head h reads KV head h // (n_heads / n_kv_heads); logits are q . k * softmax_scale.",
  "op_type": "attention",
  "models": [
    "muse-spark"
  ],
  "axes": {
    "total_q": {
      "type": "var",
      "description": "Query rows of every request."
    },
    "batch": {
      "type": "var",
      "description": "Requests."
    },
    "n_offsets": {
      "type": "var",
      "description": "Offsets in cu_seqlens_q: batch + 1."
    },
    "n_heads": {
      "type": "const",
      "value": 16,
      "description": "Query heads."
    },
    "n_kv_heads": {
      "type": "const",
      "value": 2,
      "description": "KV heads."
    },
    "head_dim": {
      "type": "const",
      "value": 64,
      "description": "Values per head."
    },
    "n_blocks": {
      "type": "var",
      "description": "Blocks of the KV cache."
    },
    "block_size": {
      "type": "const",
      "value": 16,
      "description": "Tokens per block."
    },
    "max_blocks": {
      "type": "var",
      "description": "Blocks per request in the block table."
    }
  },
  "attrs": {
    "max_seqlen_q": 8,
    "window_size": [-1, -1],
    "causal": true,
    "has_q_descale": false,
    "has_k_descale": false,
    "has_v_descale": false
  },
  "inputs": {
    "q": {
      "shape": [
        "total_q",
        "n_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The new tokens' queries, request after request."
    },
    "k": {
      "shape": [
        "n_blocks",
        "block_size",
        "n_kv_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The keys of every cached token, block by block."
    },
    "v": {
      "shape": [
        "n_blocks",
        "block_size",
        "n_kv_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The values of every cached token, block by block."
    },
    "cu_seqlens_q": {
      "shape": [
        "n_offsets"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "bounded_cu_seqlens",
        "total": "total_q",
        "max_seqlen": 8
      },
      "description": "Where each request's query rows start, then total_q."
    },
    "seqused_k": {
      "shape": [
        "batch"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 8,
        "hi": "max_blocks * block_size",
        "distinct": false
      },
      "description": "Cached tokens of each request, its new tokens included."
    },
    "block_table": {
      "shape": [
        "batch",
        "max_blocks"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "n_blocks - 1",
        "distinct": false
      },
      "description": "The blocks of each request, in context order."
    },
    "softmax_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every logit."
    },
    "softcap": {
      "shape": null,
      "dtype": "float32",
      "description": "Logit soft cap; 0 is none."
    }
  },
  "outputs": {
    "out": {
      "shape": [
        "total_q",
        "n_heads",
        "head_dim"
      ],
      "dtype": "bfloat16",
      "description": "Softmax-weighted sum of the read values, per query row."
    }
  },
