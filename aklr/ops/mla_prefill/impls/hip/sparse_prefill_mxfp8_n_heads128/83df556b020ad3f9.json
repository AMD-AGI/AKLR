    },
    "prefix_nope": {
      "shape": [
        "prefix_rows",
        512
      ],
      "dtype": "uint8",
      "distribution": {
        "kind": "mxfp8_nope_rows"
      },
      "description": "Packed NoPE rows: 448 FP8 codes, 14 E8M0 scales, padding to 512 bytes."
    },
    "prefix_rope": {
      "shape": [
        "prefix_rows",
        64
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "RoPE keys and values corresponding to the NoPE rows."
    },
    "prefix_indices": {
      "shape": [
        "prefix_nnz"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "prefix_rows - 1",
        "distinct": false
      },
      "description": "CSR entries selecting rows of the pool."
    },
    "prefix_indptr": {
      "shape": [
        "n_offsets"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "cu_seqlens",
        "min_seqlen": 0,
        "total": "prefix_nnz"
      },
      "description": "Monotone CSR offsets for each query, beginning with zero."
    },
    "extend_nope": {
      "shape": [
        "extend_rows",
        512
      ],
      "dtype": "uint8",
      "distribution": {
        "kind": "mxfp8_nope_rows"
      },
      "description": "Packed NoPE rows: 448 FP8 codes, 14 E8M0 scales, padding to 512 bytes."
    },
    "extend_rope": {
      "shape": [
        "extend_rows",
        64
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "RoPE keys and values corresponding to the NoPE rows."
    },
    "extend_indices": {
      "shape": [
        "extend_nnz"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "extend_rows - 1",
        "distinct": false
      },
      "description": "CSR entries selecting rows of the pool."
    },
    "extend_indptr": {
      "shape": [
        "n_offsets"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "cu_seqlens",
        "min_seqlen": 0,
        "total": "extend_nnz"
      },
      "description": "Monotone CSR offsets for each query, beginning with zero."
    },
    "sinks": {
      "shape": [
        "n_heads"
      ],
      "dtype": "float32",
      "distribution": {
        "kind": "finite"
      },
      "description": "Per-head softmax sink logits."
    },
    "softmax_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplier of the combined QK score."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "n_tokens",
