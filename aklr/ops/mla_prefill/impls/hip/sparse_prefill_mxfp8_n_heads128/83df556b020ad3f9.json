{
  "schema_version": 5,
  "name": "sparse_prefill_mxfp8_n_heads128",
  "contract_id": "sparse_prefill_mxfp8@1.0",
  "description": "Sparse attention over two CSR ranges. NoPE uses block-scaled E4M3FN and RoPE BF16; each head's sink contributes only to the softmax denominator.",
  "op_type": "mla_prefill",
  "axes": {
    "n_tokens": {
      "type": "var",
      "description": "Query rows."
    },
    "n_heads": {
      "type": "const",
      "value": 128,
      "description": "Query heads."
    },
    "prefix_rows": {
      "type": "var",
      "description": "Rows of the prefix pool."
    },
    "extend_rows": {
      "type": "var",
      "description": "Rows of the extend pool."
    },
    "prefix_nnz": {
      "type": "var",
      "description": "Prefix CSR entries."
    },
    "extend_nnz": {
      "type": "var",
      "description": "Extend CSR entries."
    },
    "n_offsets": {
      "type": "var",
      "description": "CSR offsets, queries plus one."
    }
  },
  "attrs": {},
  "inputs": {
