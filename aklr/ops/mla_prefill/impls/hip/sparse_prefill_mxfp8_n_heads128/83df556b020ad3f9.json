        "kind": "mxfp8_nope_rows"
      },
      "description": "Packed NoPE query rows."
    },
    "q_rope": {
      "shape": [
        "n_tokens",
        "n_heads",
        64
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
