  "name": "flash_mla_with_kvcache_causal_bf16_lse_has_block_table_has_cu_seqlens_k_kv_cache_bfloat16_query_length8_n_heads96_page_size1",
  "contract_id": "flash_mla_with_kvcache@1.0",
  "description": "MLA attention over a paged KV pool, FlashMLA's API. Sparse: each token attends to the slots its indices name, in the pool and the optional extra one; sinks join the normalisation only. Dense: each request attends to its context rows; q's rope part is last, scores are q . row * sm_scale * kv_scale and values row[:head_dim_v] * kv_scale. With causal, query i of a request of length L reads its first L - query_length + i + 1 rows.",
  "op_type": "mla",
  "models": [
    "kimi-k3"
  ],
  "axes": {
    "batch": {
      "type": "var",
      "description": "Rows: one token each (sparse) or one request each (dense)."
    },
    "query_length": {
      "type": "const",
      "value": 8,
      "description": "Queries per row."
    },
    "n_heads": {
      "type": "const",
      "value": 96,
      "description": "Query heads."
    },
    "n_pages": {
      "type": "var",
      "description": "Pages of the KV pool."
    },
    "page_size": {
      "type": "const",
      "value": 1,
      "description": "Slots per page of the KV pool."
    },
    "table_width": {
      "type": "var",
      "description": "Columns of the 2-D block_table, or length of the flat one."
    },
    "n_offsets": {
      "type": "var",
      "description": "Offsets in cu_seqlens_k: batch + 1."
    }
  },
  "attrs": {
    "causal": true,
    "kv_cache_format": "bf16",
    "return_lse": true,
    "has_sparse_indices": false,
    "has_sparse_lens": false,
    "has_extra_kv_cache": false,
    "has_extra_sparse_indices": false,
    "has_extra_sparse_lens": false,
    "has_block_table": true,
    "has_cache_seqlens": false,
    "has_cu_seqlens_k": true,
    "has_sinks": false
  },
  "inputs": {
    "q": {
      "shape": [
        "batch",
        "query_length",
        "n_heads",
        576
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The queries of each row; dense: the rope part last."
    },
    "kv_cache": {
      "shape": [
        "n_pages",
        "page_size",
        1,
        576
      ],
      "dtype": "bfloat16",
      "distribution": {
        "kind": "finite"
      },
      "description": "The KV pool: packed dsv4 slots, or one 576-value row a page."
    },
    "block_table": {
      "shape": [
        "table_width"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "int_range",
        "lo": 0,
        "hi": "n_pages * page_size - 1",
        "distinct": false
      },
      "description": "Pool rows of each request: a (batch, width) table read up to cache_seqlens, or every request's rows back to back."
    },
    "cu_seqlens_k": {
      "shape": [
        "n_offsets"
      ],
      "dtype": "int32",
      "distribution": {
        "kind": "cu_seqlens",
        "min_seqlen": 8,
        "total": "table_width"
      },
      "description": "Where each request's rows start in block_table, then its length."
    },
    "head_dim_v": {
      "shape": null,
      "dtype": "int32",
      "description": "Values per output head: 512 dense, None sparse."
    },
    "sm_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every logit."
    },
    "kv_scale": {
      "shape": null,
      "dtype": "float32",
      "description": "Multiplies every KV value, in the logits and the values."
    }
  },
  "outputs": {
    "output": {
      "shape": [
        "batch",
        "query_length",
        "n_heads",
        512
      ],
      "dtype": "bfloat16",
      "description": "Softmax-weighted sum of the read values; 0 for no row read."
    },
    "lse": {
      "shape": [
        "batch",
        "query_length",
        "n_heads"
      ],
      "dtype": "float32",
      "description": "Log-sum-exp of the scaled logits, sinks excluded; for no row read +inf (sparse) or -inf (dense)."
    }
  },
