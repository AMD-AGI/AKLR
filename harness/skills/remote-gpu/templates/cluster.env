# <NAME> — remote-gpu cluster manifest. Made from templates/cluster.env with the facts
# scripts/probe-cluster read from the login node.
# remote-gpu sources it locally and on the login node; other skills read it to choose a cluster
# (GPU_ARCH, GPUS_PER_NODE, MAX_TIME, ...). Plain KEY=value lines, one fact each. No absolute
# paths: a path is $HOME/... or comes from WORK_ROOT=auto, both resolved on the cluster.
VERIFIED=YYYY-MM-DD                # the day these facts were read
DESCRIPTION='<scheduler> <cluster>, <n> x <gpus> <GPU model> nodes'   # one line, for `remote-gpu help`

# Login
HOST=${<NAME>_HOST:-<login-host>}  # ssh destination of the login node; the variable overrides it
LOGIN_HOSTS='<hostname -s glob>'   # matches the login nodes' `hostname -s`: remote-gpu runs there without ssh
LOGIN_PROFILE=0                    # 1: the scheduler's commands or environment only come with a login shell
PRIORITY=50                        # alloc without --cluster: ties go to the lowest

# Scheduler
SCHEDULER=slurm                    # slurm | spur; what cluster.sh was adapted for
SCHEDULER_VERSION=<x.y.z>
PARTITION=''                       # alloc's partition; '' = the scheduler's default
ACCOUNTS=''                        # allowed ACCOUNT:QOS pairs, in preference order; '' = the user's default association
BURST_QOS=''                       # preemptible pool; only --preemptible or explicit -q opts in
ALLOC_AGGRESSIVE=0                 # 1: shared alloc races team ACCOUNTS by default; --aggressive works with every adapter
MAX_TIME=24:00:00                  # longest -t alloc can ask for
EXTEND=0                           # 1: users may lengthen a running job (remote-gpu extend)
PREEMPTION='<who can preempt these jobs, and when>'

# Compute nodes
NODE_NAMES='<glob>'
NODE_COUNT=<n>                     # in PARTITION
GPU_VENDOR=AMD
GPU_MODEL=<MI355X>
GPU_ARCH=<gfx950>                  # what kernels are built for; check on a node: gfx_target_version in KFD sysfs
GPUS_PER_NODE=8                    # alloc takes whole nodes; the health check wants this many
CPUS_PER_NODE=<n>
MEM_PER_NODE_GB=<n>
NODE_SSH=0                         # 1: compute nodes accept ssh (remote-gpu never needs it)
DOCKER=1                           # docker on the compute nodes

# Storage
WORK_ROOT=auto                     # base of relative paths, state dir is WORK_ROOT/<NAME>; auto = the network
                                   # filesystem with the most free space that holds a writable dir named $USER owned by $USER
HOME_FULL=0                        # 1: $HOME is nearly full, so tool caches go to the state dir
DOCKER_FLAGS=''                    # extra `docker run` flags --image adds, e.g. --privileged
