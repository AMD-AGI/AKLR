{
 "schema": 1,
 "gpus": 8,
 "served_model_name": "moonshotai/Kimi-K3",
 "aiter": "stack",
 "launch": {
  "command": [
   "python3",
   "-m",
   "sglang.launch_server",
   "--model-path",
   "${E2E_MODEL_PATH}",
   "--served-model-name",
   "moonshotai/Kimi-K3",
   "--host",
   "127.0.0.1",
   "--port",
   "${E2E_PORT}",
   "--cuda-graph-max-bs-decode",
   "256",
   "--dcp-comm-backend",
   "a2a",
   "--dcp-size",
   "8",
   "--decode-attention-backend",
   "aiter",
   "--dtype",
   "bfloat16",
   "--enable-linear-replayssm-spec",
   "--enable-metrics",
   "--kv-cache-dtype",
   "fp8_e4m3",
   "--mamba-full-memory-ratio",
   "7.97",
   "--mem-fraction-static",
   "0.85",
   "--prefill-attention-backend",
   "aiter",
   "--reasoning-parser",
   "kimi_k3",
   "--speculative-algorithm",
   "DSPARK",
   "--speculative-draft-model-path",
   "RadixArk/Kimi-K3-DSpark",
   "--speculative-dspark-block-size",
   "7",
   "--tool-call-parser",
   "kimi_k3",
   "--tp-size",
   "8",
   "--trust-remote-code"
  ],
  "env": {
   "AITER_FLYDSL_FORCE": "1",
   "AITER_SITUV2_A8W4": "1",
   "HF_HUB_OFFLINE": "1",
   "PYTHONNOUSERSITE": "1",
   "SGLANG_AITER_HONOR_EXPLICIT_MEM_FRACTION": "1",
   "SGLANG_AITER_K3_OPT": "1",
   "SGLANG_TIMEOUT_KEEP_ALIVE": "900",
   "SGLANG_USE_AITER": "1"
  }
 },
 "runtime": {
  "ready_timeout_s": 7200,
  "poll_s": 10,
  "point_timeout_s": 3600
 },
 "notes": "The SGLang cookbook's MI355X command for Kimi-K3 (DSpark block 7), as AgentX serves it: with SGLANG_AITER_HONOR_EXPLICIT_MEM_FRACTION, without which SGLang 0.5.23 scales --mem-fraction-static 0.85 to 0.7225 under the AITER backend and does not start; TP8, DCP8. Both modes serve on stack.json's AITER, which has the aiter.plugin AKLR serves AITER's ops through (the install gives SGLang 0.5.23's SiTU call the weights' gate/up layout that AITER reads, as sgl-project/sglang#51000 does); the hub holds RadixArk/Kimi-K3-DSpark beside the model."
}
