  "points": [
    {
      "arm": "tp8-ep1-dcp8-none-spec-mtp",
      "conc": 1,
      "served_model_name": "moonshotai/Kimi-K3",
      "gpus": 8,
      "launch": {
        "command": [
          "python3",
          "-m",
          "sglang.launch_server",
          "--model-path",
          "${AGENTX_MODEL_PATH}",
          "--served-model-name",
          "moonshotai/Kimi-K3",
          "--host",
          "127.0.0.1",
          "--port",
          "${AGENTX_PORT}",
          "--cuda-graph-max-bs-decode",
          "256",
          "--dcp-comm-backend",
          "a2a",
          "--dcp-size",
          "8",
          "--decode-attention-backend",
          "aiter",
          "--dtype",
          "bfloat16",
          "--enable-linear-replayssm-spec",
          "--enable-metrics",
          "--kv-cache-dtype",
          "fp8_e4m3",
          "--mamba-full-memory-ratio",
          "7.97",
          "--mem-fraction-static",
          "0.85",
          "--prefill-attention-backend",
          "aiter",
          "--reasoning-parser",
          "kimi_k3",
          "--speculative-algorithm",
          "DSPARK",
          "--speculative-draft-model-path",
          "RadixArk/Kimi-K3-DSpark",
          "--speculative-dspark-block-size",
          "7",
          "--tool-call-parser",
          "kimi_k3",
          "--tp-size",
          "8",
          "--trust-remote-code"
        ],
        "env": {
          "AITER_FLYDSL_FORCE": "1",
          "AITER_SITUV2_A8W4": "1",
          "HF_HUB_OFFLINE": "1",
          "SGLANG_AITER_K3_OPT": "1",
          "SGLANG_USE_AITER": "1"
        }
      },
      "client_env": {
        "AIPERF_DYNAMO_SESSION_TIMEOUT_SECONDS": "3600",
