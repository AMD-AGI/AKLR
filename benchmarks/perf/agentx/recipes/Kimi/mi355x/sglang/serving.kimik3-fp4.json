        "AIPERF_REQUIRED_SERVER_METRIC_PREFIX": "sglang:",
        "AIPERF_USE_DYNAMO_CONV_AWARE_ROUTING": "1",
        "CONC": "1",
        "DCP_SIZE": "8",
        "DP_ATTENTION": "false",
        "DURATION": "3600",
        "ENABLE_AGENTX_POWER": "false",
        "EP_SIZE": "1",
        "EVAL_ONLY": "false",
        "FRAMEWORK": "sglang",
        "IS_AGENTIC": "1",
        "IS_MULTINODE": "false",
        "KV_OFFLOADING": "none",
        "MODEL": "moonshotai/Kimi-K3",
        "MODEL_PREFIX": "kimik3",
        "PCP_SIZE": "1",
        "PP_SIZE": "1",
        "PRECISION": "fp4",
        "REQUIRE_POWER": "0",
        "SPEC_ALGORITHM": "dspark",
        "SPEC_DRAFT_MODEL": "RadixArk/Kimi-K3-DSpark",
        "TOTAL_CPU_DRAM_GB": "0",
        "TP": "8"
      },
      "runtime": {
        "port": 30000,
        "ready_timeout_s": 7200,
        "poll_s": 10,
